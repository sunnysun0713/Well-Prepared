# 本地开发(与 docker-compose.yml 一致,直接复制为 .env 即可)
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=13306
DB_USER=nezha
DB_PASSWORD=nezha123
DB_NAME=nezha
REDIS_URL=redis://127.0.0.1:16379

# 部署华为云时替换(ECS 与 RDS/DCS 同 VPC 内网直连,不暴露公网):
# DB_HOST=<RDS 内网地址>
# DB_PORT=3306
# DB_USER=<创建实例时的用户名>
# DB_PASSWORD=<创建实例时的密码>
# DB_NAME=nezha
# REDIS_URL=redis://:<DCS密码>@<DCS内网地址>:6379
