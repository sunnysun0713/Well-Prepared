# NeZha 同步服务 Nginx 反向代理示例
# 用途:把 HTTPS(443) 转发到本机 Node 服务(3000),满足 Android 9+ 对 HTTPS 的要求。
# 用法:
#   1. 把本文件复制到 /etc/nginx/conf.d/nezha-sync.conf
#   2. 替换 sync.example.com 为你的域名(需已解析到 ECS 公网 IP)
#   3. 证书路径按实际填写:华为云 SSL 证书下载后通常是 .pem + .key
#   4. nginx -t && systemctl reload nginx

server {
    listen 80;
    server_name sync.example.com;
    # 强制跳转 HTTPS
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name sync.example.com;

    ssl_certificate     /etc/nginx/ssl/sync.example.com.pem;
    ssl_certificate_key /etc/nginx/ssl/sync.example.com.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;

    # 同步接口请求体上限与后端 express.json 的 2mb 保持一致
    client_max_body_size 2m;

    location / {
        proxy_pass         http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 15s;
    }
}
